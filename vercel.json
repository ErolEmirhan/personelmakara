{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/workbox-(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/(index\\.html|registerSW\\.js|manifest\\.webmanifest)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    {
      "source": "/((?!assets/|icons/|logo\\.png|makara\\.png|sw\\.js|registerSW\\.js|manifest\\.webmanifest|workbox-).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    { "source": "/mobile", "destination": "/", "permanent": false },
    { "source": "/mobile/", "destination": "/", "permanent": false }
  ]
}
